.support-hero {
  padding: 34rpx;
  background: linear-gradient(135deg, #fffdf8 0%, #fff1dc 100%);
}

.eyebrow {
  color: #b56b35;
  font-size: 24rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
}

.support-title {
  margin-top: 10rpx;
  font-size: 46rpx;
  font-weight: 900;
  line-height: 1.2;
}

.support-subtitle {
  margin-top: 16rpx;
  color: #625c53;
  font-size: 28rpx;
  line-height: 1.6;
}

.safety-card {
  margin-top: 20rpx;
  padding: 24rpx;
  border-color: #e5b3a0;
  background: #fff4ef;
}

.safety-title {
  color: #9b3f2f;
  font-size: 28rpx;
  font-weight: 800;
}

.safety-content {
  margin-top: 10rpx;
  color: #6b4338;
  font-size: 25rpx;
  line-height: 1.55;
}

.night-card {
  margin-top: 18rpx;
  padding: 24rpx;
  border-color: #c7d7e6;
  background: #f3f8fb;
}

.night-title {
  color: #355e78;
  font-size: 29rpx;
  font-weight: 900;
}

.night-content,
.night-step {
  margin-top: 10rpx;
  color: #3d5363;
  font-size: 25rpx;
  line-height: 1.55;
}

.risk-card {
  margin-top: 18rpx;
  padding: 24rpx;
  border-color: #c44c3a;
  background: #fff0ed;
}

.risk-title {
  color: #9b2f24;
  font-size: 30rpx;
  font-weight: 900;
}

.risk-content {
  margin-top: 10rpx;
  color: #5f2d27;
  font-size: 26rpx;
  line-height: 1.6;
}

.risk-plan {
  margin-top: 16rpx;
  padding: 16rpx;
  border-radius: 6rpx;
  background: #fffdf8;
  color: #5f2d27;
  font-size: 24rpx;
  line-height: 1.55;
}

.call-button {
  margin-top: 14rpx;
  min-height: 68rpx;
  font-size: 24rpx;
}

.reason-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
}

.reason-card {
  padding: 24rpx 18rpx;
  color: #625c53;
  font-size: 28rpx;
  font-weight: 700;
  text-align: center;
}

.reason-card.active {
  border-color: #2f6655;
  background: #eff6f1;
  color: #2f6655;
}

.urge-input {
  width: 100%;
  min-height: 260rpx;
  padding: 24rpx;
  color: #2f2a25;
  font-size: 28rpx;
  line-height: 1.6;
}

.save-button {
  margin-top: 18rpx;
  font-size: 27rpx;
}

.saved-card {
  margin-top: 22rpx;
  padding: 24rpx;
  border-color: #cce1d5;
  background: #eff6f1;
}

.saved-title {
  color: #2f6655;
  font-size: 30rpx;
  font-weight: 800;
}

.saved-content {
  margin-top: 10rpx;
  color: #4d6258;
  font-size: 25rpx;
  line-height: 1.55;
}

.saved-risk {
  margin-top: 14rpx;
  padding: 16rpx;
  border-radius: 6rpx;
  background: #fff0ed;
  color: #9b2f24;
  font-size: 24rpx;
  line-height: 1.5;
}

.record-list {
  display: grid;
  gap: 16rpx;
}

.record-card {
  padding: 22rpx;
}

.record-card.active {
  border-color: #2f6655;
  background: #f4faf6;
}

.record-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.record-reason {
  color: #2f6655;
  font-size: 26rpx;
  font-weight: 900;
}

.record-time {
  color: #7c756c;
  font-size: 23rpx;
}

.record-preview {
  margin-top: 10rpx;
  color: #625c53;
  font-size: 25rpx;
  line-height: 1.5;
}

.record-detail {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #d7e4dc;
}

.record-draft {
  color: #2f2a25;
  font-size: 27rpx;
  line-height: 1.65;
  white-space: pre-wrap;
}

.record-risk {
  margin-top: 14rpx;
  padding: 16rpx;
  border-radius: 6rpx;
  background: #fff0ed;
  color: #9b2f24;
  font-size: 24rpx;
  line-height: 1.5;
}

.record-hint {
  margin-top: 12rpx;
  color: #7c756c;
  font-size: 22rpx;
}

.step-list {
  display: grid;
  gap: 16rpx;
}

.step-row {
  display: flex;
  gap: 18rpx;
  padding: 22rpx;
}

.step-index {
  display: flex;
  flex: 0 0 auto;
  align-items: center;
  justify-content: center;
  width: 42rpx;
  height: 42rpx;
  border-radius: 50%;
  background: #2f6655;
  color: #fffdf8;
  font-size: 24rpx;
  font-weight: 800;
}

.step-content {
  flex: 1;
  color: #3c362f;
  font-size: 27rpx;
  line-height: 1.55;
}

.safety-plan {
  padding: 24rpx;
}

.plan-input {
  width: 100%;
  min-height: 76rpx;
  margin-bottom: 14rpx;
  padding: 0 18rpx;
  border: 1rpx solid #eadcc5;
  border-radius: 8rpx;
  background: #fffaf0;
  color: #2f2a25;
  font-size: 26rpx;
}

.plan-textarea {
  width: 100%;
  min-height: 132rpx;
  padding: 18rpx;
  border: 1rpx solid #eadcc5;
  border-radius: 8rpx;
  background: #fffaf0;
  color: #2f2a25;
  font-size: 26rpx;
  line-height: 1.5;
}

.plan-save {
  margin-top: 16rpx;
  min-height: 74rpx;
  font-size: 25rpx;
}

.support-actions {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
  margin-top: 28rpx;
}

.support-action-main {
  grid-column: 1 / -1;
  min-height: 86rpx;
  font-size: 29rpx;
}

.support-action-secondary {
  min-height: 76rpx;
  padding-left: 12rpx;
  padding-right: 12rpx;
  font-size: 24rpx;
}
