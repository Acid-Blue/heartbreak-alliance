.hero {
  padding: 34rpx;
  background: #fffdf8;
}

.hero-title {
  font-size: 48rpx;
  font-weight: 800;
  line-height: 1.2;
}

.hero-subtitle {
  margin-top: 16rpx;
  color: #625c53;
  font-size: 28rpx;
  line-height: 1.65;
}

.hero-actions {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
  margin-top: 28rpx;
}

.hero-button {
  margin: 0;
  min-height: 76rpx;
  padding-left: 14rpx;
  padding-right: 14rpx;
  font-size: 25rpx;
}

.hero-button-main {
  grid-column: 1 / -1;
  min-height: 86rpx;
  font-size: 30rpx;
}

.urgent-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  min-height: 76rpx;
  margin-left: 0;
  margin-right: 0;
  padding: 14rpx;
  border: 1rpx solid #d89462;
  border-radius: 8rpx;
  background: #fff1dc;
  color: #9b4f25;
  font-size: 25rpx;
  font-weight: 800;
  line-height: 1.3;
  text-align: center;
  white-space: nowrap;
  word-break: keep-all;
}

.community-grid {
  display: grid;
  gap: 18rpx;
}

.community-card {
  padding: 26rpx;
}

.community-name {
  font-size: 32rpx;
  font-weight: 700;
}

.community-summary {
  margin-top: 12rpx;
  color: #625c53;
  font-size: 26rpx;
  line-height: 1.55;
}

.community-tags {
  margin-top: 18rpx;
}

.community-meta {
  margin-top: 18rpx;
  color: #7c756c;
  font-size: 24rpx;
}

.post-card {
  margin-bottom: 18rpx;
  padding: 24rpx;
}

.post-top,
.post-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.post-type {
  color: #2f6655;
  font-size: 24rpx;
  font-weight: 700;
}

.post-time,
.post-footer {
  color: #7c756c;
  font-size: 24rpx;
}

.post-content {
  margin: 16rpx 0 18rpx;
  font-size: 29rpx;
  line-height: 1.65;
}
