.agent-page {
  display: flex;
  height: 100vh;
  min-height: 0;
  flex-direction: column;
  overflow: hidden;
  padding-bottom: 24rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}

.agent-head {
  flex: 0 0 auto;
  padding: 28rpx;
}

.agent-page .boundary {
  flex: 0 0 auto;
}

.agent-title {
  font-size: 42rpx;
  font-weight: 800;
}

.agent-subtitle {
  margin-top: 12rpx;
  color: #625c53;
  font-size: 28rpx;
  line-height: 1.55;
}

.context-line {
  margin-top: 14rpx;
  color: #2f6655;
  font-size: 24rpx;
}

.support-entry {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  min-height: 76rpx;
  margin-top: 22rpx;
  padding: 14rpx 18rpx 14rpx 22rpx;
  border: 1rpx solid #d89462;
  border-radius: 8rpx;
  background: #fff1dc;
  color: #9b4f25;
}

.support-entry-text {
  display: flex;
  min-width: 0;
  align-items: baseline;
  gap: 14rpx;
}

.support-entry-title {
  flex: 0 0 auto;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 1.2;
  white-space: nowrap;
}

.support-entry-desc {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  color: #9f6946;
  font-size: 23rpx;
  line-height: 1.2;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.support-entry-arrow {
  flex: 0 0 auto;
  margin-left: 12rpx;
  color: #b56b35;
  font-size: 36rpx;
  line-height: 1;
}

.message-list {
  flex: 1;
  min-height: 0;
  height: 0;
  margin-top: 20rpx;
}

.message {
  display: flex;
  margin-bottom: 18rpx;
}

.message.from-user {
  justify-content: flex-end;
}

.message.from-agent {
  justify-content: flex-start;
}

.bubble {
  max-width: 84%;
  padding: 20rpx;
}

.from-user .bubble {
  background: #eff6f1;
  border-color: #cce1d5;
}

.message-content {
  font-size: 28rpx;
  line-height: 1.6;
}

.message-meta {
  margin-top: 12rpx;
  color: #7c756c;
  font-size: 22rpx;
  line-height: 1.4;
}

.message-bottom {
  height: 1rpx;
}

.composer {
  display: flex;
  flex: 0 0 auto;
  align-items: flex-end;
  gap: 12rpx;
  margin-top: 14rpx;
  padding: 12rpx;
}

.composer-input {
  flex: 1;
  min-width: 0;
  min-height: 68rpx;
  max-height: 180rpx;
  padding: 14rpx 16rpx;
  border-radius: 6rpx;
  background: #fffdf8;
  color: #2f2a25;
  font-size: 27rpx;
  line-height: 1.45;
  overflow: auto;
}

.send-button {
  flex: 0 0 auto;
  width: 96rpx;
  height: 68rpx;
  margin: 0;
  padding: 0;
  border-radius: 8rpx;
  background: #2f6655;
  color: #fffdf8;
  font-size: 26rpx;
  line-height: 68rpx;
}
