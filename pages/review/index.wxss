.review-hero {
  padding: 34rpx;
  background: linear-gradient(135deg, #fffdf8 0%, #eef6f2 100%);
}

.eyebrow {
  color: #2f6655;
  font-size: 24rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
}

.review-title {
  margin-top: 10rpx;
  font-size: 46rpx;
  font-weight: 900;
  line-height: 1.2;
}

.review-subtitle {
  margin-top: 16rpx;
  color: #625c53;
  font-size: 28rpx;
  line-height: 1.6;
}

.mode-row {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 12rpx;
  margin-top: 24rpx;
}

.mode-tab {
  padding: 18rpx 8rpx;
  border: 1rpx solid #e5d8c6;
  border-radius: 999rpx;
  background: #fffdf8;
  color: #7c756c;
  font-size: 24rpx;
  font-weight: 800;
  text-align: center;
}

.mode-tab.active {
  border-color: #2f6655;
  background: #2f6655;
  color: #fffdf8;
}

.option-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
}

.option-card {
  min-height: 86rpx;
  padding: 22rpx 16rpx;
  color: #625c53;
  font-size: 27rpx;
  font-weight: 700;
  text-align: center;
}

.option-card.active {
  border-color: #2f6655;
  background: #eff6f1;
  color: #2f6655;
}

.pattern-card {
  min-height: 156rpx;
  text-align: left;
}

.option-title {
  font-size: 27rpx;
  font-weight: 900;
}

.option-desc {
  margin-top: 8rpx;
  color: #7c756c;
  font-size: 23rpx;
  font-weight: 500;
  line-height: 1.45;
}

.pattern-card.active .option-desc {
  color: #3d6f5f;
}

.level-row {
  display: flex;
  gap: 14rpx;
}

.level-dot {
  display: flex;
  flex: 1;
  align-items: center;
  justify-content: center;
  height: 72rpx;
  border: 1rpx solid #ece2d4;
  border-radius: 8rpx;
  background: #fffdf8;
  color: #7c756c;
  font-size: 28rpx;
  font-weight: 800;
}

.level-dot.active {
  border-color: #2f6655;
  background: #2f6655;
  color: #fffdf8;
}

.field-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  padding: 24rpx;
}

.field-title {
  color: #2f2a25;
  font-size: 29rpx;
  font-weight: 800;
}

.field-desc {
  margin-top: 8rpx;
  color: #7c756c;
  font-size: 24rpx;
  line-height: 1.5;
}

.section-title.small {
  font-size: 27rpx;
}

.draft-input {
  width: 100%;
  min-height: 260rpx;
  padding: 24rpx;
  color: #2f2a25;
  font-size: 28rpx;
  line-height: 1.6;
}

.draft-input.compact {
  min-height: 168rpx;
}

.stacked-input {
  margin-top: 16rpx;
}

.analysis-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
}

.mini-field {
  padding: 22rpx;
}

.mini-input {
  width: 100%;
  min-height: 150rpx;
  margin-top: 14rpx;
  color: #2f2a25;
  font-size: 25rpx;
  line-height: 1.5;
}

.support-input {
  width: 100%;
  min-height: 82rpx;
  margin-top: 16rpx;
  padding: 0 24rpx;
  color: #2f2a25;
  font-size: 27rpx;
}

.submit-button {
  margin-top: 18rpx;
}

.dashboard-card,
.mini-record {
  padding: 24rpx;
}

.dashboard-title,
.mini-record-title {
  color: #2f6655;
  font-size: 29rpx;
  font-weight: 900;
}

.dashboard-summary,
.dashboard-next,
.mini-record-content {
  margin-top: 10rpx;
  color: #3c362f;
  font-size: 25rpx;
  line-height: 1.55;
}

.dashboard-next {
  font-weight: 700;
}

.review-day-row {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12rpx;
  margin-top: 16rpx;
}

.review-day {
  min-height: 64rpx;
  padding: 16rpx 8rpx;
  border: 1rpx solid #e5d8c6;
  border-radius: 8rpx;
  background: #fffdf8;
  color: #625c53;
  font-size: 23rpx;
  font-weight: 800;
  text-align: center;
}

.review-day.active {
  border-color: #2f6655;
  background: #eff6f1;
  color: #2f6655;
}

.progress-level-header {
  margin-top: 22rpx;
}

.mini-record {
  margin-bottom: 16rpx;
}

.result-card {
  margin-top: 24rpx;
  padding: 26rpx;
  border-color: #cce1d5;
  background: #eff6f1;
}

.result-card.pause,
.result-card.safety {
  border-color: #e5b3a0;
  background: #fff4ef;
}

.result-card.plan,
.result-card.prepare,
.result-card.review,
.result-card.wait {
  border-color: #cce1d5;
  background: #eff6f1;
}

.result-kicker {
  color: #7c756c;
  font-size: 23rpx;
}

.result-title {
  margin-top: 8rpx;
  color: #2f6655;
  font-size: 32rpx;
  font-weight: 900;
}

.result-card.pause .result-title,
.result-card.safety .result-title {
  color: #9b3f2f;
}

.result-summary,
.result-next {
  margin-top: 12rpx;
  color: #3c362f;
  font-size: 26rpx;
  line-height: 1.6;
}

.result-next {
  font-weight: 700;
}

.result-list-item {
  margin-top: 10rpx;
  color: #3c362f;
  font-size: 25rpx;
  line-height: 1.55;
}

.result-meta {
  margin-top: 14rpx;
  color: #7c756c;
  font-size: 23rpx;
}

.review-actions {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
  margin-top: 28rpx;
}

.review-actions .secondary-button {
  min-height: 76rpx;
  padding-left: 12rpx;
  padding-right: 12rpx;
  font-size: 24rpx;
}

@media (max-width: 360px) {
  .analysis-grid,
  .option-grid,
  .mode-row,
  .review-day-row {
    grid-template-columns: 1fr;
  }
}
