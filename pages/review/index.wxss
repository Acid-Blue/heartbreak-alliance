.review-hero {
  padding: 34rpx;
  background: linear-gradient(135deg, #fffdf8 0%, #eef6f2 100%);
}

.eyebrow {
  color: #2f6655;
  font-size: 24rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
}

.review-title {
  margin-top: 10rpx;
  font-size: 46rpx;
  font-weight: 900;
  line-height: 1.2;
}

.review-subtitle {
  margin-top: 16rpx;
  color: #625c53;
  font-size: 28rpx;
  line-height: 1.6;
}

.option-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
}

.option-card {
  min-height: 86rpx;
  padding: 22rpx 16rpx;
  color: #625c53;
  font-size: 27rpx;
  font-weight: 700;
  text-align: center;
}

.option-card.active {
  border-color: #2f6655;
  background: #eff6f1;
  color: #2f6655;
}

.level-row {
  display: flex;
  gap: 14rpx;
}

.level-dot {
  display: flex;
  flex: 1;
  align-items: center;
  justify-content: center;
  height: 72rpx;
  border: 1rpx solid #ece2d4;
  border-radius: 8rpx;
  background: #fffdf8;
  color: #7c756c;
  font-size: 28rpx;
  font-weight: 800;
}

.level-dot.active {
  border-color: #2f6655;
  background: #2f6655;
  color: #fffdf8;
}

.field-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  padding: 24rpx;
}

.field-title {
  color: #2f2a25;
  font-size: 29rpx;
  font-weight: 800;
}

.field-desc {
  margin-top: 8rpx;
  color: #7c756c;
  font-size: 24rpx;
  line-height: 1.5;
}

.draft-input {
  width: 100%;
  min-height: 260rpx;
  padding: 24rpx;
  color: #2f2a25;
  font-size: 28rpx;
  line-height: 1.6;
}

.submit-button {
  margin-top: 18rpx;
}

.result-card {
  margin-top: 24rpx;
  padding: 26rpx;
  border-color: #cce1d5;
  background: #eff6f1;
}

.result-card.pause,
.result-card.safety {
  border-color: #e5b3a0;
  background: #fff4ef;
}

.result-kicker {
  color: #7c756c;
  font-size: 23rpx;
}

.result-title {
  margin-top: 8rpx;
  color: #2f6655;
  font-size: 32rpx;
  font-weight: 900;
}

.result-card.pause .result-title,
.result-card.safety .result-title {
  color: #9b3f2f;
}

.result-summary,
.result-next {
  margin-top: 12rpx;
  color: #3c362f;
  font-size: 26rpx;
  line-height: 1.6;
}

.result-next {
  font-weight: 700;
}

.result-meta {
  margin-top: 14rpx;
  color: #7c756c;
  font-size: 23rpx;
}

.review-actions {
  display: grid;
  gap: 16rpx;
  margin-top: 28rpx;
}
