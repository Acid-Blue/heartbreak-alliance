<view class="page community-page">
  <view class="page-title">阵线小队</view>
  <view class="page-intro">固定小队更像读书会：持续在场、慢慢熟悉、一起把混乱的日子整理清楚。</view>

  <view wx:if="{{loading}}" class="empty">正在加载阵线小队...</view>
  <view wx:elif="{{error}}" class="empty card" bindtap="loadCommunities">{{error}}</view>

  <view wx:else class="community-list">
    <view wx:if="{{communities.length === 0}}" class="empty card">暂时没有开放的小队。</view>
    <view
      wx:for="{{communities}}"
      wx:key="id"
      class="community-row card"
      data-id="{{item.id}}"
      bindtap="openCommunity"
    >
      <view class="row-head">
        <view class="row-title">{{item.name}}</view>
        <view class="join-state {{item.isJoined ? 'joined' : ''}}">{{item.isJoined ? '已加入' : '可加入'}}</view>
      </view>
      <view class="row-summary">{{item.summary}}</view>
      <view class="pill-row">
        <text wx:for="{{item.tags}}" wx:key="*this" class="pill">{{item}}</text>
      </view>
      <view class="row-meta">{{item.memberCount}} 人 · 今日 {{item.activeToday}} 人在场 · {{item.mood}}</view>
    </view>
  </view>
</view>
