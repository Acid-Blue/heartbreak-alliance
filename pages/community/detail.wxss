.detail-head {
  padding: 30rpx;
}

.detail-title {
  font-size: 42rpx;
  font-weight: 800;
}

.detail-summary {
  margin-top: 14rpx;
  color: #625c53;
  font-size: 28rpx;
  line-height: 1.6;
}

.detail-tags {
  margin-top: 18rpx;
}

.detail-meta {
  margin-top: 18rpx;
  color: #7c756c;
  font-size: 24rpx;
  line-height: 1.45;
}

.detail-actions {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
  margin-top: 26rpx;
}

.action-button {
  width: 100%;
  min-width: 0;
  height: 86rpx;
  margin: 0;
  padding: 0 12rpx;
  font-size: 27rpx;
}

.post-card {
  margin-bottom: 18rpx;
  padding: 24rpx;
}

.post-top,
.post-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.post-type {
  color: #2f6655;
  font-size: 24rpx;
  font-weight: 700;
}

.post-time,
.post-footer {
  color: #7c756c;
  font-size: 24rpx;
}

.post-content {
  margin: 16rpx 0 18rpx;
  font-size: 29rpx;
  line-height: 1.65;
}
