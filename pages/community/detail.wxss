.detail-head {
  padding: 30rpx;
}

.detail-title {
  font-size: 42rpx;
  font-weight: 800;
}

.detail-summary {
  margin-top: 14rpx;
  color: #625c53;
  font-size: 28rpx;
  line-height: 1.6;
}

.detail-tags {
  margin-top: 18rpx;
}

.detail-meta {
  margin-top: 18rpx;
  color: #7c756c;
  font-size: 24rpx;
  line-height: 1.45;
}

.stage-line {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 18rpx;
}

.stage-tag,
.match-tag {
  min-height: 44rpx;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: #f4efe4;
  color: #625c53;
  font-size: 22rpx;
  font-weight: 800;
}

.match-tag {
  background: #eff6f1;
  color: #2f6655;
}

.template-card {
  margin-top: 20rpx;
  padding: 18rpx;
  border-radius: 8rpx;
  background: #f8f2e8;
}

.template-title {
  color: #8b6421;
  font-size: 24rpx;
  font-weight: 900;
}

.template-content {
  margin-top: 8rpx;
  color: #625c53;
  font-size: 24rpx;
  line-height: 1.5;
}

.detail-actions {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 18rpx;
  margin-top: 26rpx;
}

.action-button {
  width: 100%;
  min-width: 0;
  height: 86rpx;
  margin: 0;
  padding: 0 12rpx;
  font-size: 25rpx;
}

.post-card {
  margin-bottom: 18rpx;
  padding: 24rpx;
}

.checkin-composer,
.checkin-row,
.guideline-card {
  margin-bottom: 18rpx;
  padding: 22rpx;
}

.checkin-input {
  width: 100%;
  min-height: 150rpx;
  color: #2f2a25;
  font-size: 27rpx;
  line-height: 1.55;
}

.checkin-button {
  margin-top: 16rpx;
  min-height: 74rpx;
  font-size: 26rpx;
}

.checkin-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.checkin-author {
  color: #2f6655;
  font-size: 26rpx;
  font-weight: 900;
}

.checkin-time {
  color: #7c756c;
  font-size: 23rpx;
}

.checkin-content,
.guideline-row {
  margin-top: 10rpx;
  color: #3c362f;
  font-size: 25rpx;
  line-height: 1.55;
}

.post-top,
.post-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.post-type {
  color: #2f6655;
  font-size: 24rpx;
  font-weight: 700;
}

.post-time,
.post-footer {
  color: #7c756c;
  font-size: 24rpx;
}

.post-content {
  margin: 16rpx 0 18rpx;
  font-size: 29rpx;
  line-height: 1.65;
}
