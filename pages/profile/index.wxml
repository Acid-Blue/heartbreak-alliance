<view class="page profile-page">
  <view wx:if="{{loading}}" class="empty">正在加载个人空间...</view>
  <view wx:elif="{{error}}" class="empty card" bindtap="loadProfile">{{error}}</view>

  <block wx:else>
    <view class="profile-card card">
      <view class="avatar">{{user.avatar}}</view>
      <view class="profile-main">
        <view class="nickname">{{user.nickname}}</view>
        <view class="profile-note">已加入 {{joinedCommunities.length}} 个阵线小队</view>
      </view>
    </view>

    <view class="boundary">{{boundary}}</view>

    <view class="section">
      <view class="section-header">
        <text class="section-title">我的阵线小队</text>
      </view>
      <view wx:if="{{joinedCommunities.length === 0}}" class="empty card">还没有加入小队。</view>
      <view
        wx:for="{{joinedCommunities}}"
        wx:key="id"
        class="joined-row card"
        data-id="{{item.id}}"
        bindtap="openCommunity"
      >
        <view class="joined-name">{{item.name}}</view>
        <view class="joined-summary">{{item.summary}}</view>
      </view>
    </view>

    <view class="section">
      <view class="section-header">
        <text class="section-title">我的发布</text>
      </view>
      <view wx:if="{{myPosts.length === 0}}" class="empty card">还没有发布内容。</view>
      <view wx:for="{{myPosts}}" wx:key="id" class="my-post card" data-id="{{item.id}}" bindtap="openPost">
        <view class="post-top">
          <text class="post-type">{{item.typeText}}</text>
          <text class="post-time">{{item.relativeTime}}</text>
        </view>
        <view class="post-content">{{item.content}}</view>
      </view>
    </view>

    <view class="section">
      <view class="section-header">
        <text class="section-title">Agent 权限</text>
        <text class="section-action" bindtap="openAgent">去对话</text>
      </view>
      <view class="permission card">
        <view class="permission-row">
          <view>
            <view class="permission-name">参考本人发布和回应</view>
            <view class="permission-help">用于整理你自己的情绪线索。</view>
          </view>
          <view class="permission-control">
            <text class="permission-state">{{user.agentPermissions.ownContent ? '已允许' : '已关闭'}}</text>
            <switch
              checked="{{user.agentPermissions.ownContent}}"
              color="#2F6655"
              disabled="{{savingPermission}}"
              data-key="ownContent"
              bindchange="onPermissionChange"
            />
          </view>
        </view>
        <view class="permission-row">
          <view>
            <view class="permission-name">参考小队公开内容</view>
            <view class="permission-help">用于结合你所在阵线小队的公开经验。</view>
          </view>
          <view class="permission-control">
            <text class="permission-state">{{user.agentPermissions.publicCommunityContent ? '已允许' : '已关闭'}}</text>
            <switch
              checked="{{user.agentPermissions.publicCommunityContent}}"
              color="#2F6655"
              disabled="{{savingPermission}}"
              data-key="publicCommunityContent"
              bindchange="onPermissionChange"
            />
          </view>
        </view>
        <view class="permission-desc">Agent 不读取私聊、通讯录或非公开内容。后续接入真实模型前，需要再次确认隐私授权和数据范围。</view>
      </view>
    </view>
  </block>
</view>
