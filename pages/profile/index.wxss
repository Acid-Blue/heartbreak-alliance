.profile-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 28rpx;
}

.avatar-button {
  display: flex;
  flex: 0 0 auto;
  align-items: center;
  justify-content: center;
  width: 92rpx;
  height: 92rpx;
  margin: 0;
  padding: 0;
  border-radius: 50%;
  background: transparent;
  line-height: 1;
}

.avatar-button::after,
.profile-save::after,
.profile-reset::after {
  border: 0;
}

.avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 92rpx;
  height: 92rpx;
  border-radius: 50%;
  background: #2f6655;
  color: #fffdf8;
  font-size: 40rpx;
  font-weight: 800;
}

.avatar-image {
  width: 92rpx;
  height: 92rpx;
  border-radius: 50%;
  background: #eee3d1;
}

.profile-main {
  flex: 1;
  min-width: 0;
}

.nickname-input {
  min-height: 46rpx;
  color: #2f2a24;
  font-size: 34rpx;
  font-weight: 800;
}

.profile-note {
  margin-top: 8rpx;
  color: #7c756c;
  font-size: 24rpx;
}

.profile-editor {
  padding: 24rpx;
}

.field-label {
  margin-bottom: 14rpx;
  color: #2f2a24;
  font-size: 26rpx;
  font-weight: 800;
}

.stage-row {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-bottom: 24rpx;
}

.stage-pill {
  padding: 12rpx 22rpx;
  border: 2rpx solid #e4d5bd;
  border-radius: 999rpx;
  background: #fffaf0;
  color: #625c53;
  font-size: 24rpx;
  font-weight: 700;
}

.stage-pill.active {
  border-color: #2f6655;
  background: #e5f0e6;
  color: #2f6655;
}

.bio-input {
  box-sizing: border-box;
  width: 100%;
  min-height: 132rpx;
  padding: 18rpx;
  border: 2rpx solid #eadcc5;
  border-radius: 22rpx;
  background: #fffdf8;
  color: #2f2a24;
  font-size: 26rpx;
  line-height: 1.55;
}

.profile-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 22rpx;
}

.profile-save,
.profile-reset {
  flex: 1;
  margin: 0;
  border-radius: 999rpx;
  font-size: 26rpx;
  font-weight: 800;
  line-height: 76rpx;
}

.profile-save {
  background: #2f6655;
  color: #fffdf8;
}

.profile-reset {
  border: 2rpx solid #d8c7ad;
  background: #fffaf0;
  color: #625c53;
}

.profile-help {
  margin-top: 18rpx;
  color: #7c756c;
  font-size: 23rpx;
  line-height: 1.5;
}

.joined-row,
.my-post,
.permission {
  margin-bottom: 18rpx;
  padding: 24rpx;
}

.joined-name {
  font-size: 30rpx;
  font-weight: 700;
}

.joined-summary {
  margin-top: 10rpx;
  color: #625c53;
  font-size: 25rpx;
  line-height: 1.55;
}

.post-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.post-type {
  color: #2f6655;
  font-size: 24rpx;
  font-weight: 700;
}

.post-time {
  color: #7c756c;
  font-size: 24rpx;
}

.post-content {
  margin-top: 14rpx;
  font-size: 28rpx;
  line-height: 1.6;
}

.rebuild-summary,
.rebuild-card,
.rebuild-record {
  margin-bottom: 18rpx;
  padding: 24rpx;
}

.rebuild-summary-title {
  color: #2f6655;
  font-size: 29rpx;
  font-weight: 900;
}

.rebuild-summary-content,
.rebuild-summary-next,
.rebuild-record-content {
  margin-top: 10rpx;
  color: #3c362f;
  font-size: 25rpx;
  line-height: 1.55;
}

.rebuild-summary-next {
  font-weight: 700;
}

.task-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
}

.task-chip {
  min-height: 96rpx;
  padding: 16rpx;
  border: 1rpx solid #e4d5bd;
  border-radius: 8rpx;
  background: #fffaf0;
}

.task-chip.active {
  border-color: #2f6655;
  background: #eff6f1;
}

.task-label {
  color: #2f2a24;
  font-size: 25rpx;
  font-weight: 800;
  line-height: 1.35;
}

.task-category {
  margin-top: 8rpx;
  color: #7c756c;
  font-size: 22rpx;
}

.task-chip.active .task-label,
.task-chip.active .task-category {
  color: #2f6655;
}

.level-label {
  margin-top: 22rpx;
}

.level-row {
  display: flex;
  gap: 12rpx;
}

.level-dot {
  display: flex;
  flex: 1;
  align-items: center;
  justify-content: center;
  height: 62rpx;
  border: 1rpx solid #eadcc5;
  border-radius: 8rpx;
  background: #fffdf8;
  color: #7c756c;
  font-size: 25rpx;
  font-weight: 800;
}

.level-dot.active {
  border-color: #2f6655;
  background: #2f6655;
  color: #fffdf8;
}

.rebuild-note {
  width: 100%;
  min-height: 132rpx;
  margin-top: 18rpx;
  padding: 18rpx;
  border: 1rpx solid #eadcc5;
  border-radius: 8rpx;
  background: #fffdf8;
  color: #2f2a24;
  font-size: 25rpx;
  line-height: 1.5;
}

.rebuild-actions {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
  margin-top: 18rpx;
}

.rebuild-button {
  min-height: 74rpx;
  font-size: 24rpx;
}

.rebuild-record-top {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
  color: #7c756c;
  font-size: 23rpx;
}

.rebuild-task-inline {
  display: inline-flex;
  margin-right: 12rpx;
}

.permission-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin-bottom: 18rpx;
}

.permission-name {
  color: #2f2a24;
  font-size: 28rpx;
  font-weight: 700;
}

.permission-help {
  margin-top: 6rpx;
  color: #7c756c;
  font-size: 23rpx;
  line-height: 1.45;
}

.permission-control {
  display: flex;
  flex: 0 0 auto;
  align-items: center;
  gap: 10rpx;
}

.permission-state {
  color: #2f6655;
  font-size: 24rpx;
  font-weight: 700;
}

.permission-desc {
  color: #7c756c;
  font-size: 24rpx;
  line-height: 1.55;
}

.moderation-entry {
  padding: 24rpx;
}

.moderation-title {
  color: #2f6655;
  font-size: 28rpx;
  font-weight: 900;
}

.moderation-desc {
  margin-top: 10rpx;
  color: #625c53;
  font-size: 24rpx;
  line-height: 1.5;
}
